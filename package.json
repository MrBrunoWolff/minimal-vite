{
  "name": "minimal-vite",
  "private": false,
  "version": "0.1.0",
  "description": "A minimal Vite starter template with TypeScript support",
  "scripts": {
    "start": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "check": "bun run --parallel --no-exit-on-error typecheck build",
    "audit": "bun audit --audit-level=high"
  },
  "bin": {
    "minimal-vite": "bin/minimal-vite.js"
  },
  "files": [
    "bin",
    "src",
    "index.html",
    "tsconfig.json",
    "vite.config.ts",
    "favicon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "vite",
    "typescript",
    "template",
    "starter",
    "boilerplate",
    "scaffold"
  ],
  "author": "Bruno Wolff",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrBrunoWolff/minimal-vite.git"
  },
  "devDependencies": {
    "terser": "^5.50.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.0"
}
